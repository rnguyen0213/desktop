+bool nsWindow::ZenKeepsFrameActive() const {
+  return mIsZenBrowserWindow && mMicaBackdrop && WinUtils::MicaEnabled();
+}
+
+// Zen: browser windows show the acrylic backdrop over the whole window, under
+// a see-through tint drawn by the front end. Give them a frame that suits it
+// and keep the backdrop when the window is inactive (see WM_NCACTIVATE).
+void nsWindow::ZenUpdateWindowFrame() {
+  if (!mIsZenBrowserWindow || !mWnd) {
+    return;
+  }
+  const bool useBackdrop = ZenKeepsFrameActive();
+  const int8_t state = (useBackdrop ? 1 : 0) | (mZenDarkFrame ? 2 : 0);
+  if (state == mZenAppliedFrameState) {
+    return;
+  }
+  mZenAppliedFrameState = state;
+
+  // Without this, "Show accent color on title bars" paints an accent band
+  // across the top of the window.
+  const COLORREF caption =
+      useBackdrop ? DWMWA_COLOR_NONE : DWMWA_COLOR_DEFAULT;
+  const COLORREF border = !useBackdrop    ? DWMWA_COLOR_DEFAULT
+                          : mZenDarkFrame ? 0x00454545
+                                          : 0x00D9D9D9;
+  const DWM_WINDOW_CORNER_PREFERENCE corner =
+      useBackdrop ? DWMWCP_ROUND : DWMWCP_DEFAULT;
+  ::DwmSetWindowAttribute(mWnd, DWMWA_CAPTION_COLOR, &caption, sizeof caption);
+  ::DwmSetWindowAttribute(mWnd, DWMWA_BORDER_COLOR, &border, sizeof border);
+  ::DwmSetWindowAttribute(mWnd, DWMWA_WINDOW_CORNER_PREFERENCE, &corner,
+                          sizeof corner);
+
+  UpdateOpaqueRegionInternal();
+  if (useBackdrop) {
+    // In case the window is currently inactive, see WM_NCACTIVATE.
+    ::PostMessageW(mWnd, WM_NCACTIVATE, TRUE, -1);
+  }
+}
+
+void nsWindow::SetWindowClass(const nsAString& aXulWinType,
+                              const nsAString& aXulWinClass,
+                              const nsAString& aXulWinName) {
+  if (mWindowType != WindowType::TopLevel || mIsZenBrowserWindow ||
+      !aXulWinType.EqualsLiteral("navigator:browser")) {
+    return;
+  }
+  mIsZenBrowserWindow = true;
+  ZenUpdateWindowFrame();
+}
